# ============================================================
# Path constants for the JUMP benchmark (subcell-analysis/jump)
# Usage in SLURM launchers:  set -a; source ../.env; set +a
# Usage in Python:           os.environ["CROP_ROOT"]
#
# Fill in every empty value below for your setup. Values written with
# ${PROJECT_ROOT} work as-is once PROJECT_ROOT is set.
# ============================================================

# --- Project root: absolute path to this jump/ folder ---
PROJECT_ROOT=

# --- Input crops (read-only) ---
# 15 plates, 192x1728 uint8 PNGs (9 channels stacked horizontally)
# Channel order: [Mito, AGP, RNA, ER, DNA, HighZBF, LowZBF, BF, Mask]
# Structure: {CROP_ROOT}/{plate}/{well}/{fov}/crops/crop_{X}_x_{Y}.png
CROP_ROOT=

# --- DeepProfiler data root ---
DP_ROOT=

# --- Outputs ---
# Embeddings are large; point these at scratch or another large filesystem.
EMBED_CELL_ROOT=
EMBED_WELL_ROOT=
EMBED_PROCESSED_ROOT=
# Must stay ${PROJECT_ROOT}/results: the notebooks read ../results directly.
RESULTS_ROOT=${PROJECT_ROOT}/results

# --- Model checkpoints ---
# SubCell: downloaded by slurm_launchers/00_download_subcell_models.sh
SUBCELL_MAE_CKPT=${PROJECT_ROOT}/models/SubCellPortable/models/ybg/mae_contrast_supcon_model/encoder.pth
SUBCELL_MAE_CLF=${PROJECT_ROOT}/models/SubCellPortable/models/ybg/mae_contrast_supcon_model/classifier_s0.pth
SUBCELL_VIT_CKPT=${PROJECT_ROOT}/models/SubCellPortable/models/ybg/vit_supcon_model/encoder.pth
SUBCELL_VIT_CLF=${PROJECT_ROOT}/models/SubCellPortable/models/ybg/vit_supcon_model/classifier_s0.pth
# DINO4Cells Cell Painting checkpoint: download into models/DINO4Cells_code/
DINO_CKPT=${PROJECT_ROOT}/models/DINO4Cells_code/DINO_cell_painting_base_checkpoint.pth

# --- Cell-DINO (ViT-S/8 Cell Painting) ---
DINOV2_ROOT=${PROJECT_ROOT}/models/dinov2
# Cell-DINO Cell Painting checkpoint: download into models/dinov2/
CELL_DINO_CKPT=${PROJECT_ROOT}/models/dinov2/cell_dino_vits8_pretrain_cp-37d20e9c.pth

# --- Reference metadata (included in this folder) ---
METADATA_ROOT=${PROJECT_ROOT}/metadata
# compound -> MoA mapping (192 compounds with "usable" MoAs = MoA class has >=2 members)
MOA_METADATA=${PROJECT_ROOT}/metadata/usable_moa_metadata.csv

# --- S3 source for CellProfiler pre-aggregated profiles ---
CP_S3_BUCKET=cellpainting-gallery
CP_S3_PREFIX=cpg0000-jump-pilot/source_4/workspace/profiles/2020_11_04_CPJUMP1

# --- Conda ---
# Path to your miniconda/anaconda installation
CONDA_ROOT=
# Analysis env, created from envs/analysis.yaml
CONDA_ENV_ANALYSIS=moa
# GPU inference env (SubCell, DINO4Cells, Cell-DINO), created from envs/inference_gpu.yaml
CONDA_ENV_INFERENCE=inference_gpu

# --- DeepProfiler env (uv, Python 3.9 + TF 2.5): path to the virtualenv ---
DEEPPROF_ENV=
